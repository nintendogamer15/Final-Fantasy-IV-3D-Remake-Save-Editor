check() {
  desktop-file-validate "${srcdir}/ffiv3d-save-editor.desktop"
  appstreamcli validate --no-net "${srcdir}/io.github.nintendogamer15.FFIV3DSaveEditor.metainfo.xml"
}

package() {
  install -Dm0755 "${srcdir}/app-binary" "${pkgdir}/usr/bin/ffiv3d-save-editor"
  install -Dm0644 "${srcdir}/ffiv3d-save-editor.desktop" \
    "${pkgdir}/usr/share/applications/ffiv3d-save-editor.desktop"
  install -Dm0644 "${srcdir}/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/ffiv3d-save-editor.png"
  install -Dm0644 "${srcdir}/io.github.nintendogamer15.FFIV3DSaveEditor.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.nintendogamer15.FFIV3DSaveEditor.metainfo.xml"

  install -Dm0644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm0644 "${srcdir}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
  install -Dm0644 "${srcdir}/COPYING.LESSER" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LESSER"
  install -Dm0644 "${srcdir}/FFIV-Save-Editor-LGPL-3.0.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/FFIV-Save-Editor-LGPL-3.0.txt"
  install -Dm0644 "${srcdir}/MIT.txt" "${pkgdir}/usr/share/licenses/${pkgname}/MIT.txt"

  install -Dm0644 "${srcdir}/ADDITIONAL_PERMISSIONS.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/ADDITIONAL_PERMISSIONS.md"
  install -Dm0644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"
  install -Dm0644 "${srcdir}/README_LICENSE_SUMMARY.txt" \
    "${pkgdir}/usr/share/doc/${pkgname}/README_LICENSE_SUMMARY.txt"
}
