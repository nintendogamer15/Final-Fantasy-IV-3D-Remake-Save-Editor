# Maintainer: Robert

pkgname=ffiv3d-save-editor
pkgver="${PKGVER:-0.0.0}"
pkgrel=1
pkgdesc="Final Fantasy IV 3D Remake save editor"
arch=('x86_64')
url="https://github.com/nintendogamer15/Final-Fantasy-IV-3D-Remake-Save-Editor"
license=('LGPL-3.0-or-later')
depends=(
  'ca-certificates'
  'fontconfig'
  'glibc'
  'hicolor-icon-theme'
  'icu'
  'krb5'
  'libgcc'
  'libice'
  'libsm'
  'libstdc++'
  'libx11'
  'openssl'
  'tzdata'
  'ttf-dejavu'
  'zlib'
)
optdepends=('xdg-desktop-portal: native desktop file picker integration')
checkdepends=('appstream' 'desktop-file-utils')
options=('!strip' '!debug')
source=(
  'app-binary'
  'ffiv3d-save-editor.desktop'
  'io.github.nintendogamer15.FFIV3DSaveEditor.metainfo.xml'
  'icon.png'
  'LICENSE'
  'COPYING'
  'COPYING.LESSER'
  'ADDITIONAL_PERMISSIONS.md'
  'THIRD_PARTY_NOTICES.md'
  'README_LICENSE_SUMMARY.txt'
  'FFIV-Save-Editor-LGPL-3.0.txt'
  'MIT.txt'
)
sha256sums=(
